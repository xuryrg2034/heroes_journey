    "test:generation": "tsx src/game/generation.spec.ts",
    "test:turn-pipeline": "tsx src/game/turnPipeline.spec.ts",
    "test:damage-effects": "tsx src/game/damageEffects.spec.ts && tsx src/game/damageEffectsIntegration.spec.ts",
    "test:trunk-battles": "tsx src/game/trunkBattles.spec.ts",
    "test:chain-budget": "tsx src/game/chainBudget.spec.ts",
